# Copy this file to `.env` and fill in your real credentials.
# `config/settings.py` loads this automatically via pydantic-settings.
# On Railway/Render, set these as service environment variables instead of a file.

# --- Third-party API credentials (required) -----------------------------------------
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
CARTESIA_API_KEY=

# --- Deepgram (Speech-to-Text) ------------------------------------------------------
# DEEPGRAM_MODEL=nova-2
# DEEPGRAM_LANGUAGE=en

# --- Gemini (LLM "brain") -----------------------------------------------------------
# GEMINI_MODEL=llama-3.3-70b-versatile
# GEMINI_MAX_HISTORY_TURNS=10

# --- Cartesia (Text-to-Speech) -------------------------------------------------------
# CARTESIA_MODEL=sonic-2
# CARTESIA_VOICE_ID=694f9389-aac1-45b6-b726-9d9369183238
# CARTESIA_OUTPUT_SAMPLE_RATE=44100
# CARTESIA_OUTPUT_BIT_RATE=128000

# --- Temporal --------------------------------------------------------------------------
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=voice-bot-queue

# --- CORS (set to your Vercel frontend URL in production) --------------------------
# CORS_ORIGINS=https://echobuddy.vercel.app
