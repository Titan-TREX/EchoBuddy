# --- Python Specific ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# --- Environment & Virtual Environments ---
.venv/
venv/
ENV/
env/
.env
.env.*
!.env.example

# --- Project Assets (Voice chatbot recordings) ---
# Prevents user and bot generated audio files from being pushed to GitHub
assets/*.wav
assets/*.mp3
assets/*.webm
assets/*.ogg
assets/*.m4a
assets/*.pcm
!assets/.gitkeep

# --- Databases ---
# Keeps your chat history SQLite database safe and blocked from version control
database/*.db
database/*.sqlite
database/*.sqlite3

# --- IDEs and Editors ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- OS Specific ---
.DS_Store
Thumbs.db
desktop.ini

# --- Streamlit ---
.streamlit/config.toml

# --- RAG / vector store / user uploads ---
chroma_db/
uploaded_docs/

# --- Testing & coverage ---
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Build / deploy ---
.vercel/
dist/
build/
*.egg-info/

# --- Logs & temp ---
*.log
tmp/
temp/

# Browser-test scratch output
.playwright-mcp/
static/dist/
